[Unit]
Description=Send the daily Mentori CRM cash balance to Telegram
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/mentori/mentor-tg.env
ExecStart=/usr/local/sbin/mentori-finance-telegram balance
User=mentori-tg
Group=mentori-tg
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mentori-finance
MemoryMax=180M
UMask=0077
CapabilityBoundingSet=
LockPersonality=true
PrivateDevices=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native
