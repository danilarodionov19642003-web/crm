+async def _send_client_calendar_button(m: Message) -> bool:
+    """Issue a fresh short-lived token instead of exposing portal credentials."""
+    if m.chat.type != "private":
+        return False
+    result = await crm_client.issue_client_telegram_webapp_token(m.chat.id)
+    token = result.get("token") if result.get("ok") else None
+    if not token:
+        await m.answer(
+            "Календарь доступен после подключения Telegram к личному кабинету. "
+            "Если аккаунт уже подключён, попросите менеджера проверить привязку."
+        )
+        return False
+    calendar_url = f"{CALENDAR_WEB_APP_URL}?token={quote(str(token), safe='')}"
+    markup = InlineKeyboardMarkup(inline_keyboard=[[
+        InlineKeyboardButton(
+            text="📅 Открыть календарь",
+            web_app=WebAppInfo(url=calendar_url),
+        )
+    ]])
+    await m.answer(
+        "📅 <b>Календарь откликов</b>\n"
+        "Выберите свободную дату или измените запланированный отклик.",
+        reply_markup=markup,
+    )
+    return True
+
