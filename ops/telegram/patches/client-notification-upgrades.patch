+async def _calendar_web_app_url(
+    session: aiohttp.ClientSession,
+    telegram_chat_id: int,
+) -> str | None:
+    url = f"{settings.supabase_url}/rest/v1/rpc/issue_client_telegram_webapp_token"
+    async with session.post(
+        url,
+        headers=_supabase_headers(),
+        json={"p_telegram_chat_id": int(telegram_chat_id)},
+    ) as resp:
+        if resp.status != 200:
+            return None
+        payload = await resp.json()
+    token = payload.get("token") if isinstance(payload, dict) and payload.get("ok") else None
+    return f"{CALENDAR_WEB_APP_URL}?token={quote(str(token), safe='')}" if token else None
