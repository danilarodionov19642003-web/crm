 CALENDAR_WEB_APP_URL = "https://app.mentori.tech/pages/client/telegram-calendar.html"
+
+
+def _client_cabinet_url(token: str, initial_view: str = "home") -> str:
+    """Keep bearer tokens in the URL fragment so they never reach web logs."""
+    view = "calendar" if initial_view == "calendar" else "home"
+    return (
+        f"{CALENDAR_WEB_APP_URL}#token={quote(str(token), safe='')}&view={view}"
+    )
+
+
+async def _ensure_client_cabinet_menu_button(
+    bot: Bot,
+    chat_id: int,
+    *,
+    force: bool = False,
+) -> bool:
+    """Put a direct, persistent Mini App button beside the message field."""
+    try:
+        if not force:
+            current = await bot.get_chat_menu_button(chat_id=int(chat_id))
+            current_url = str(getattr(getattr(current, "web_app", None), "url", "") or "")
+            if (
+                isinstance(current, MenuButtonWebApp)
+                and current.text == "Кабинет"
+                and current_url.startswith(f"{CALENDAR_WEB_APP_URL}#token=")
+            ):
+                return True
+
+        result = await crm_client.issue_client_telegram_menu_token(int(chat_id))
+        token = result.get("token") if result.get("ok") else None
+        if not token:
+            return False
+        menu_url = _client_cabinet_url(str(token), "home")
+        await bot.set_chat_menu_button(
+            chat_id=int(chat_id),
+            menu_button=MenuButtonWebApp(
+                text="Кабинет",
+                web_app=WebAppInfo(url=menu_url),
+            ),
+        )
+        if not await crm_client.activate_client_telegram_menu_token(
+            int(chat_id), str(token)
+        ):
+            log.warning("menu token activation failed for chat %s", chat_id)
+        return True
+    except Exception:
+        log.warning("client cabinet menu setup failed for chat %s", chat_id, exc_info=True)
+        return False
+
+
+async def _sync_client_cabinet_menu_buttons(bot: Bot) -> None:
+    """Backfill the direct Mini App button for clients linked before release."""
+    clients = await crm_client.list_clients_with_tg()
+    configured = 0
+    for client in clients:
+        chat_id = client.get("chat_id")
+        if not chat_id:
+            continue
+        if await _ensure_client_cabinet_menu_button(bot, int(chat_id)):
+            configured += 1
+        await asyncio.sleep(0.05)
+    log.info("Client cabinet menu buttons ready: %s/%s", configured, len(clients))
 
 
