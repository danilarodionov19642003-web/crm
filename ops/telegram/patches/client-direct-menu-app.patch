+async def issue_client_telegram_menu_token(telegram_chat_id: int) -> dict[str, Any]:
+    ok, body = await _rpc(
+        "issue_client_telegram_menu_token", {"p_telegram_chat_id": int(telegram_chat_id)}
+    )
+    return body if ok and isinstance(body, dict) else {"ok": False}
+
+
+async def activate_client_telegram_menu_token(
+    telegram_chat_id: int,
+    token: str,
+) -> bool:
+    ok, body = await _rpc("activate_client_telegram_menu_token", {
+        "p_telegram_chat_id": int(telegram_chat_id),
+        "p_token": token,
+    })
+    return bool(body) if ok else False
 
 
