+async def _rpc(name: str, payload: dict[str, Any]) -> tuple[bool, Any]:
+    """Call a service-role RPC without ever touching the CRM blob."""
+    if not settings.supabase_url or not settings.supabase_service_key:
+        return False, {"message": "CRM_NOT_CONFIGURED"}
+    url = f"{settings.supabase_url}/rest/v1/rpc/{name}"
+    try:
+        async with aiohttp.ClientSession(timeout=REST_TIMEOUT) as session:
+            async with session.post(url, headers=_headers(), json=payload) as response:
+                body = await response.json(content_type=None)
+                if response.status != 200:
+                    log.warning("rpc %s %s: %s", name, response.status, body)
+                    return False, body
+                return True, body
+    except Exception as exc:
+        log.warning("rpc %s error: %s", name, exc)
+        return False, {"message": str(exc)}
+
+
+async def link_client_telegram_member(
+    token: str,
+    telegram_user_id: int,
+    telegram_chat_id: int,
+    username: str | None = None,
+    first_name: str | None = None,
+    last_name: str | None = None,
+) -> dict[str, Any]:
+    ok, body = await _rpc("link_client_telegram_member", {
+        "p_token": token,
+        "p_telegram_user_id": int(telegram_user_id),
+        "p_telegram_chat_id": int(telegram_chat_id),
+        "p_username": username,
+        "p_first_name": first_name,
+        "p_last_name": last_name,
+    })
+    if ok and isinstance(body, dict):
+        return body
+    reason = ""
+    if isinstance(body, dict):
+        reason = str(body.get("message") or body.get("details") or "")
+    return {"ok": False, "reason": reason or "LINK_FAILED"}
+
+
+async def resolve_client_telegram_context(
+    telegram_user_id: int,
+    telegram_chat_id: int,
+) -> dict[str, Any] | None:
+    ok, body = await _rpc("resolve_client_telegram_context", {
+        "p_telegram_user_id": int(telegram_user_id),
+        "p_telegram_chat_id": int(telegram_chat_id),
+    })
+    return body if ok and isinstance(body, dict) and body.get("portal_email") else None
+
+
+async def get_client_telegram_recipients(
+    portal_email: str | None = None,
+    kind: str = "status",
+) -> list[dict[str, Any]]:
+    ok, body = await _rpc("get_client_telegram_recipients", {
+        "p_portal_email": portal_email,
+        "p_kind": kind,
+    })
+    return body if ok and isinstance(body, list) else []
+
+
+async def resolve_client_text_approval(
+    request_id: int,
+    decision: str,
+    telegram_user_id: int,
+    telegram_chat_id: int,
+    comment: str | None = None,
+) -> dict[str, Any]:
+    ok, body = await _rpc("resolve_client_text_approval", {
+        "p_request_id": int(request_id),
+        "p_decision": decision,
+        "p_telegram_user_id": int(telegram_user_id),
+        "p_telegram_chat_id": int(telegram_chat_id),
+        "p_comment": comment,
+    })
+    if ok and isinstance(body, dict):
+        return body
+    reason = ""
+    if isinstance(body, dict):
+        reason = str(body.get("message") or body.get("details") or "")
+    return {"ok": False, "reason": reason or "RESOLVE_FAILED"}
+
