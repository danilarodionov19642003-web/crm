--- a/backend/crm_client.py
+++ b/backend/crm_client.py
@@ -277,0 +278,24 @@
+
+
+async def register_client_referral(
+    referral_code: str,
+    telegram_user_id: int,
+    telegram_chat_id: int,
+    username: str | None = None,
+    first_name: str | None = None,
+    last_name: str | None = None,
+) -> dict[str, Any]:
+    ok, body = await _rpc("register_client_referral", {
+        "p_referral_code": referral_code,
+        "p_telegram_user_id": int(telegram_user_id),
+        "p_telegram_chat_id": int(telegram_chat_id),
+        "p_username": username,
+        "p_first_name": first_name,
+        "p_last_name": last_name,
+    })
+    if ok and isinstance(body, dict):
+        return body
+    reason = ""
+    if isinstance(body, dict):
+        reason = str(body.get("message") or body.get("details") or "")
+    return {"ok": False, "reason": reason or "REFERRAL_FAILED"}
@@ -279,0 +304,25 @@
+async def reserve_client_referral_bonus(order_id: int) -> dict[str, Any]:
+    ok, body = await _rpc("reserve_client_referral_bonus", {"p_order_id": int(order_id)})
+    return body if ok and isinstance(body, dict) else {"eligible": False, "bonus_qty": 0}
+
+
+async def release_client_referral_bonus(order_id: int) -> bool:
+    ok, body = await _rpc("release_client_referral_bonus", {"p_order_id": int(order_id)})
+    return bool(body) if ok else False
+
+
+async def complete_client_referral_bonus(
+    order_id: int,
+    anketa_code: str,
+    anketa_name: str | None = None,
+) -> dict[str, Any]:
+    ok, body = await _rpc("complete_client_referral_bonus", {
+        "p_order_id": int(order_id),
+        "p_anketa_code": anketa_code,
+        "p_anketa_name": anketa_name,
+    })
+    if ok and isinstance(body, dict):
+        return body
+    return {"ok": False, "reason": "BONUS_COMPLETE_FAILED"}
