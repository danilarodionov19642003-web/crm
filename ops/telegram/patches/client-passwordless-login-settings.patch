+@dp.callback_query(F.data.startswith("ctgn:"))
+async def on_client_notification_setting(cb: CallbackQuery) -> None:
+    if not cb.from_user or not cb.message or cb.message.chat.id != cb.from_user.id:
+        await cb.answer("Настройки доступны только в личном чате.", show_alert=True)
+        return
+    try:
+        _, setting, enabled_raw = str(cb.data or "").split(":", 2)
+        if setting not in NOTIFICATION_SETTING_LABELS or enabled_raw not in {"0", "1"}:
+            raise ValueError("invalid callback")
+    except ValueError:
+        await cb.answer("Кнопка устарела. Откройте настройки заново.", show_alert=True)
+        return
+
+    values = await crm_client.update_client_telegram_bot_notification_setting(
+        cb.from_user.id,
+        cb.message.chat.id,
+        setting,
+        enabled_raw == "1",
+    )
+    if not values.get("ok"):
+        await cb.answer("Не удалось сохранить настройку.", show_alert=True)
+        return
+    try:
+        await cb.message.edit_reply_markup(
+            reply_markup=_client_notification_settings_markup(values)
+        )
+    except TelegramBadRequest:
+        pass
+    await cb.answer("Настройки сохранены")
