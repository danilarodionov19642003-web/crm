+NOTIFICATION_SETTING_LABELS = {
+    "status": ("Изменения статусов", "status_notifications"),
+    "schedule": ("Ежедневный план откликов", "schedule_notifications"),
+    "low_reviews": ("Остался один отзыв", "low_reviews_notifications"),
+    "order_completed": ("Пакет выполнен", "order_completed_notifications"),
+}
+
+
+def _client_notification_settings_markup(values: dict[str, object]) -> InlineKeyboardMarkup:
+    rows: list[list[InlineKeyboardButton]] = []
+    for setting, (label, field) in NOTIFICATION_SETTING_LABELS.items():
+        enabled = bool(values.get(field))
+        rows.append([InlineKeyboardButton(
+            text=f"{'✅' if enabled else '❌'} {label}",
+            callback_data=f"ctgn:{setting}:{0 if enabled else 1}",
+        )])
+    return InlineKeyboardMarkup(inline_keyboard=rows)
+
+
+async def _show_client_notification_settings(m: Message) -> None:
+    if not m.from_user or m.chat.id != m.from_user.id:
+        await m.answer("Настройки доступны только в личном чате с ботом.")
+        return
+    values = await crm_client.get_client_telegram_bot_settings(
+        m.from_user.id, m.chat.id
+    )
+    if not values.get("ok"):
+        await m.answer(
+            "Не нашёл привязанный клиентский кабинет. Нажмите /start или напишите менеджеру.",
+            reply_markup=client_ui.kb_client_root(),
+        )
+        return
+    await m.answer(
+        "🔔 <b>Настройки уведомлений</b>\n\n"
+        "Нажмите нужный пункт, чтобы включить или выключить его. "
+        "Настройка действует только для вашего Telegram-контакта.",
+        reply_markup=_client_notification_settings_markup(values),
+    )
+
+
+async def _send_client_passwordless_login(m: Message, bot: Bot) -> None:
+    if not m.from_user or m.chat.id != m.from_user.id:
+        await m.answer("Вход доступен только в личном чате с ботом.")
+        return
+    if not await _prepare_client_miniapp_access(m, bot):
+        return
+    result = await crm_client.create_client_portal_login_link(
+        m.from_user.id, m.chat.id
+    )
+    action_link = str(result.get("action_link") or "")
+    if not result.get("ok") or not action_link.startswith("https://"):
+        await m.answer(
+            "Не удалось создать вход без пароля. Попробуйте ещё раз чуть позже "
+            "или напишите менеджеру.",
+            reply_markup=client_ui.kb_client_root(),
+        )
+        return
+    await m.answer(
+        "🔐 <b>Вход в личный кабинет</b>\n\n"
+        "Кнопка откроет ваш кабинет без ввода логина и пароля.\n\n"
+        "Ссылка одноразовая. Не пересылайте её другим людям.",
+        reply_markup=InlineKeyboardMarkup(inline_keyboard=[[
+            InlineKeyboardButton(text="🔐 Войти без пароля", url=action_link)
+        ]]),
+    )
