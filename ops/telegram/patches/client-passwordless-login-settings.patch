+async def create_client_portal_login_link(
+    telegram_user_id: int,
+    telegram_chat_id: int,
+) -> dict[str, Any]:
+    """Create a one-time Supabase magic link without exposing a password."""
+    ok, context = await _rpc("prepare_client_telegram_passwordless_login", {
+        "p_telegram_user_id": int(telegram_user_id),
+        "p_telegram_chat_id": int(telegram_chat_id),
+    })
+    if not ok or not isinstance(context, dict) or not context.get("ok"):
+        reason = context.get("reason") if isinstance(context, dict) else None
+        return {"ok": False, "reason": reason or "LOGIN_NOT_AVAILABLE"}
+
+    login_email = str(context.get("login_email") or "").strip().lower()
+    expected_user_id = str(context.get("auth_user_id") or "").strip()
+    if not login_email or not expected_user_id:
+        return {"ok": False, "reason": "CLIENT_ACCOUNT_NOT_FOUND"}
+
+    url = f"{settings.supabase_url.rstrip('/')}/auth/v1/admin/generate_link"
+    payload = {
+        "type": "magiclink",
+        "email": login_email,
+        "redirect_to": CLIENT_PORTAL_LOGIN_REDIRECT,
+    }
+    try:
+        async with aiohttp.ClientSession(timeout=REST_TIMEOUT) as session:
+            async with session.post(url, headers=_headers(), json=payload) as response:
+                body = await response.json(content_type=None)
+                if response.status != 200 or not isinstance(body, dict):
+                    log.warning("passwordless login generation failed: status=%s", response.status)
+                    return {"ok": False, "reason": "LOGIN_LINK_GENERATION_FAILED"}
+
+                generated_user = body.get("user") if isinstance(body.get("user"), dict) else {}
+                generated_user_id = str(generated_user.get("id") or body.get("id") or "").strip()
+                if generated_user_id and generated_user_id != expected_user_id:
+                    log.error("passwordless login user mismatch")
+                    return {"ok": False, "reason": "LOGIN_ACCOUNT_MISMATCH"}
+
+                properties = body.get("properties") if isinstance(body.get("properties"), dict) else {}
+                action_link = str(body.get("action_link") or properties.get("action_link") or "").strip()
+                if not action_link.startswith("https://"):
+                    return {"ok": False, "reason": "LOGIN_LINK_GENERATION_FAILED"}
+                return {"ok": True, "action_link": action_link}
+    except Exception:
+        log.warning("passwordless login generation error", exc_info=True)
+        return {"ok": False, "reason": "LOGIN_LINK_GENERATION_FAILED"}
+
+
