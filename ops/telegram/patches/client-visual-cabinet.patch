+async def _answer_client_visual(
+    m: Message,
+    text: str,
+    reply_markup: ReplyKeyboardMarkup,
+    photo_url: str | None = None,
+) -> None:
+    """Send a branded visual card and gracefully fall back to plain text."""
+    candidates = [photo_url, CLIENT_CABINET_IMAGE_URL]
+    attempted: set[str] = set()
+    for candidate in candidates:
+        photo = str(candidate or "").strip()
+        if not photo.startswith("https://") or photo in attempted:
+            continue
+        attempted.add(photo)
+        try:
+            await m.answer_photo(photo=photo, caption=text, reply_markup=reply_markup)
+            return
+        except Exception as exc:
+            log.warning("client visual send failed for %s: %s", photo, exc)
+    await m.answer(text, reply_markup=reply_markup)
