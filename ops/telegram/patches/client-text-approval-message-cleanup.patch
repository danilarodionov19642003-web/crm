+async def _record_text_approval_delivery(
+    session: aiohttp.ClientSession,
+    row_id: int,
+    expected_chat_id: int,
+    telegram_message: dict[str, Any],
+) -> None:
+    message_id = int(telegram_message.get("message_id") or 0)
+    result_chat = telegram_message.get("chat") or {}
+    delivered_chat_id = int(result_chat.get("id") or 0)
+    if message_id <= 0 or delivered_chat_id != expected_chat_id:
+        raise RuntimeError("Telegram sendMessage returned an invalid message identity")
+    payload = {
+        "p_outbox_id": int(row_id),
+        "p_telegram_chat_id": delivered_chat_id,
+        "p_telegram_message_id": message_id,
+    }
+    last_error: Exception | None = None
+    for _attempt in range(2):
+        try:
+            await _rpc(session, "record_client_text_approval_telegram_delivery", payload)
+            return
+        except Exception as exc:
+            last_error = exc
+    raise RuntimeError(f"could not record Telegram approval message: {last_error}")
