+    except Exception as exc:
+        error = str(exc)
+        if _is_already_deleted_error(error):
+            # deleteMessage is idempotent from our point of view: if the exact
+            # message is already absent, the clean-chat outcome is complete.
+            await _complete_message_deletion(session, delivery_id, True, None, True)
+            return
+        final = (
+            _is_permanent_delete_error(error)
