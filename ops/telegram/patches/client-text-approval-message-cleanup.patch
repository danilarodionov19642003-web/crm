+async def delete_order_status_message(chat_id: int, message_id: int) -> bool:
+    """Delete one exact bot message; callers persist and retry the command."""
+    if not settings.bot_token:
+        raise RuntimeError("BOT_TOKEN не задан в .env")
+    url = _bot_api_url("deleteMessage")
+    payload = {"chat_id": int(chat_id), "message_id": int(message_id)}
+    timeout = aiohttp.ClientTimeout(total=15)
+    async with aiohttp.ClientSession(timeout=timeout) as sess:
+        async with sess.post(url, json=payload) as resp:
+            data = await resp.json()
+            if not data.get("ok"):
+                desc = data.get("description", "unknown error")
+                raise RuntimeError(f"Bot API error: {desc}")
+            return True
+
+
+async def compact_order_status_message(chat_id: int, message_id: int, text: str) -> bool:
+    """Replace one old approval with a short result and remove its buttons."""
+    if not settings.bot_token:
+        raise RuntimeError("BOT_TOKEN не задан в .env")
+    url = _bot_api_url("editMessageText")
+    payload = {
+        "chat_id": int(chat_id),
+        "message_id": int(message_id),
+        "text": text,
+        "parse_mode": "HTML",
+        "reply_markup": {"inline_keyboard": []},
+    }
+    timeout = aiohttp.ClientTimeout(total=15)
+    async with aiohttp.ClientSession(timeout=timeout) as sess:
+        async with sess.post(url, json=payload) as resp:
+            data = await resp.json()
+            if not data.get("ok"):
+                desc = data.get("description", "unknown error")
+                raise RuntimeError(f"Bot API error: {desc}")
+            return True
