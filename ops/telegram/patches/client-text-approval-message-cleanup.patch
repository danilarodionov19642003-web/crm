+async def _mark_skipped(session: aiohttp.ClientSession, row_id: int, reason: str) -> None:
+    """Do not send an approval that was already resolved or removed."""
+    url = f"{settings.supabase_url}/rest/v1/notification_outbox?id=eq.{row_id}&status=eq.pending"
+    payload = {"status": "skipped", "last_error": reason[:500]}
+    headers = {**_supabase_headers(), "Prefer": "return=minimal"}
+    async with session.patch(url, headers=headers, json=payload) as resp:
+        if resp.status not in (200, 204):
+            text = await resp.text()
+            log.warning("mark_skipped #%s failed %s: %s", row_id, resp.status, text[:200])
+
