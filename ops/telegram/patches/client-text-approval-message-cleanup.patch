+async def _process_message_deletion(
+    session: aiohttp.ClientSession,
+    delivery: dict[str, Any],
+) -> None:
+    delivery_id = int(delivery["id"])
+    chat_id = int(delivery["telegram_chat_id"])
+    message_id = int(delivery["telegram_message_id"])
+    attempts = int(delivery.get("delete_attempts") or 0) + 1
