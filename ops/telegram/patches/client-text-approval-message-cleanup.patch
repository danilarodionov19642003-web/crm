+async def _rpc(
+    session: aiohttp.ClientSession,
+    function_name: str,
+    payload: dict[str, Any],
+) -> dict[str, Any]:
+    url = f"{settings.supabase_url}/rest/v1/rpc/{function_name}"
+    async with session.post(url, headers=_supabase_headers(), json=payload) as resp:
+        body = await resp.json(content_type=None)
+        if resp.status != 200:
+            raise RuntimeError(f"{function_name} {resp.status}: {str(body)[:300]}")
+        if not isinstance(body, dict) or not body.get("ok"):
+            raise RuntimeError(f"{function_name} rejected: {str(body)[:300]}")
+        return body
