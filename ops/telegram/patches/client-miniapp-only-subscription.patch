+async def _sync_client_cabinet_menu_buttons(bot: Bot) -> None:
+    """Verify every linked client and reconcile the subscription-gated menu."""
+    clients = await crm_client.list_client_telegram_channel_members()
+    configured = 0
+    denied = 0
+    for client in clients:
+        chat_id = client.get("telegram_chat_id")
+        user_id = client.get("telegram_user_id") or chat_id
+        if not chat_id or not user_id:
+            continue
+        membership = await _client_channel_membership(bot, int(user_id))
+        if membership is None:
+            continue
+        result = await crm_client.set_client_telegram_channel_subscription(
+            int(chat_id), membership
+        )
+        if not result.get("ok"):
+            continue
+        if membership and await _ensure_client_cabinet_menu_button(bot, int(chat_id)):
+            configured += 1
+        elif not membership:
+            await _clear_client_cabinet_menu_button(bot, int(chat_id))
+            denied += 1
+        await asyncio.sleep(0.05)
+    log.info(
+        "Client Mini App subscription sync: allowed=%s denied=%s total=%s",
+        configured, denied, len(clients),
+    )
+
