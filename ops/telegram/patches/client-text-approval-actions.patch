+async def _fetch_text_approval(
+    session: aiohttp.ClientSession,
+    request_id: int,
+) -> dict[str, Any] | None:
+    url = (
+        f"{settings.supabase_url}/rest/v1/client_text_approval_requests"
+        f"?id=eq.{request_id}"
+        f"&select=title,body,anketa_code,anketa_name,source_profile_id,request_status"
+        f"&limit=1"
+    )
+    async with session.get(url, headers=_supabase_headers()) as resp:
+        if resp.status != 200:
+            text = await resp.text()
+            raise RuntimeError(f"fetch_text_approval {resp.status}: {text[:300]}")
+        rows = await resp.json()
+        return rows[0] if rows else None
+
+
+def _format_text_approval_message(
+    request: dict[str, Any] | None,
+    fallback: str,
+) -> str:
+    divider = "━━━━━━━━━━━━━━"
+    if not request:
+        return (
+            "📝 <b>ТЕКСТ НА СОГЛАСОВАНИЕ</b>\n"
+            f"{divider}\n\n"
+            f"{fallback}\n\n"
+            f"{divider}\n"
+            "👇 <b>Проверьте текст и выберите действие:</b>"
+        )
 
+    title_parts = [part.strip() for part in str(request.get("title") or "").split("·")]
+    account_name = title_parts[-1] if len(title_parts) > 1 else "Аккаунт"
+    anketa_code = str(request.get("anketa_code") or "Анкета").upper()
+    anketa_name = str(request.get("anketa_name") or "").strip()
+    anketa_label = anketa_code if not anketa_name else f"{anketa_code} · {anketa_name}"
+    body = html.escape(str(request.get("body") or "").strip())
+    return (
+        "📝 <b>ТЕКСТ НА СОГЛАСОВАНИЕ</b>\n"
+        f"{divider}\n\n"
+        f"📋 <b>Анкета:</b> {html.escape(anketa_label)}\n"
+        f"👤 <b>Аккаунт:</b> {html.escape(account_name)}\n\n"
+        "💬 <b>Текст отзыва:</b>\n"
+        f"<blockquote>{body}</blockquote>\n\n"
+        f"{divider}\n"
+        "👇 <b>Проверьте текст и выберите действие:</b>"
+    )
 
